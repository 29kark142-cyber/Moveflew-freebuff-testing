# MoveFlew production environment
# Copy to .env (local) or set these in your hosting provider. Never commit real values.

# ── Supabase ────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only. Required for webhooks, cron sweeps and public proposal enrichment.
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe ──────────────────────────────────────────────────────────────────
# Server secret used to create AI scan pack Checkout Sessions.
STRIPE_SECRET_KEY=
# Signing secret for POST /api/webhooks/stripe (whsec_...).
STRIPE_WEBHOOK_SECRET=
# Public publishable key for the embedded deposit payment UI.
VITE_PAYMENTS_CLIENT_TOKEN=
# Optional legacy connector keys and their webhook secrets.
STRIPE_SANDBOX_API_KEY=
STRIPE_LIVE_API_KEY=
PAYMENTS_SANDBOX_WEBHOOK_SECRET=
PAYMENTS_LIVE_WEBHOOK_SECRET=
LOVABLE_API_KEY=

# ── Notifications ───────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SENDGRID_API_KEY=
# Verified sender address for customer email.
MESSAGING_FROM_EMAIL=

# ── Scheduled jobs ──────────────────────────────────────────────────────────
# Bearer token required by /api/cron/notifications. Use a long random value.
CRON_SECRET=
# Public origin used in tracking links, review messages and Stripe return URLs.
PUBLIC_SITE_URL=

# ── Maps ────────────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_API_KEY=
